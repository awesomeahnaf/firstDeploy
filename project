<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>IUB Mart | Campus Peer-to-Peer Marketplace</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
          colors: {
            iub: {
              navy: '#0B2545',
              blue: '#134074',
              royal: '#1D4ED8',
              teal: '#0D9488',
              emerald: '#10B981',
              surface: '#F8FAFC',
            }
          },
          boxShadow: {
            'card': '0 4px 20px -2px rgba(11, 37, 69, 0.06), 0 2px 6px -1px rgba(11, 37, 69, 0.04)',
            'card-hover': '0 14px 30px -5px rgba(11, 37, 69, 0.12), 0 6px 12px -4px rgba(13, 148, 136, 0.08)',
          }
        }
      }
    }
  </script>

  <style>
    /* Custom scrollbar & smooth transitions */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    @keyframes heartPop {
      0% { transform: scale(1); }
      45% { transform: scale(1.35); }
      100% { transform: scale(1); }
    }
    .animate-heart {
      animation: heartPop 0.32s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @keyframes slideInRight {
      from { transform: translateX(100%); }
      to { transform: translateX(0); }
    }
    .drawer-enter {
      animation: slideInRight 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes modalFadeIn {
      from { opacity: 0; transform: scale(0.96) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .modal-enter {
      animation: modalFadeIn 0.22s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased selection:bg-teal-100 selection:text-teal-900">

  <!-- Top Academic Campus Banner -->
  <div class="bg-[#0B2545] text-slate-200 text-xs py-1.5 px-4 border-b border-white/10">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-teal-500/20 text-teal-300 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
          Bashundhara R/A Campus
        </span>
        <span class="hidden sm:inline text-slate-300">Exclusive Peer-to-Peer Exchange for Independent University, Bangladesh Students</span>
      </div>
      <div class="flex items-center gap-4 text-slate-300">
        <span class="inline-flex items-center gap-1">
          <!-- Shield Check SVG -->
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          @iub.edu.bd Verified Peers
        </span>
        <button onclick="resetDemoData()" class="hover:text-white underline decoration-slate-500 underline-offset-2 transition" title="Restore original catalog items">
          Reset Demo Data
        </button>
      </div>
    </div>
  </div>

  <!-- Sticky Main Navbar -->
  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 sm:h-18 gap-3 sm:gap-6">
        
        <!-- Brand Logo -->
        <a href="#" onclick="resetAllFilters(event)" class="flex items-center gap-2.5 shrink-0 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#0B2545] via-[#134074] to-teal-600 flex items-center justify-center text-white shadow-md group-hover:shadow-teal-500/25 transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-lg sm:text-xl font-extrabold tracking-tight text-[#0B2545]">IUB <span class="text-teal-600">Mart</span></span>
              <span class="hidden md:inline-block text-[10px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded bg-blue-50 text-[#134074] border border-blue-100">Campus</span>
            </div>
            <p class="hidden sm:block text-[11px] text-slate-500 leading-none">Buy • Sell • Rent at IUB</p>
          </div>
        </a>

        <!-- Desktop Search Input -->
        <div class="hidden md:flex flex-1 max-w-xl relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 103.5 10.5a7.5 7.5 0 0013.15 6.15z"/>
            </svg>
          </div>
          <input
            type="text"
            id="desktopSearchInput"
            oninput="handleSearchInput(this.value)"
            placeholder="Search textbooks, CSE203, Casio 991EX, Arduino, lab coat..."
            class="w-full pl-10 pr-9 py-2.5 bg-slate-100/90 hover:bg-slate-100 focus:bg-white text-sm text-slate-800 placeholder-slate-400 rounded-xl border border-transparent focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 outline-none transition"
          />
          <button
            id="clearSearchBtnDesktop"
            onclick="clearSearch()"
            class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600"
            title="Clear search"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Action Buttons: Wishlist & Post Item -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <!-- Wishlist Drawer Trigger -->
          <button
            onclick="toggleWishlistDrawer(true)"
            class="relative inline-flex items-center gap-2 px-3 sm:px-3.5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200/80 text-slate-700 font-semibold text-sm transition active:scale-95"
            aria-label="Open Wishlist"
          >
            <svg class="w-5 h-5 text-rose-500 fill-rose-500/15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            <span class="hidden sm:inline">Wishlist</span>
            <span
              id="wishlistBadge"
              class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-bold rounded-full bg-rose-500 text-white shadow-xs"
            >0</span>
          </button>

          <!-- Post an Item Trigger -->
          <button
            onclick="openPostModal()"
            class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#0B2545] to-[#134074] hover:from-[#134074] hover:to-teal-700 text-white font-semibold text-sm shadow-sm hover:shadow-md transition active:scale-95"
          >
            <svg class="w-4 h-4 text-teal-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Post Item</span>
          </button>
        </div>
      </div>

      <!-- Mobile Search Bar -->
      <div class="pb-3 md:hidden">
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 103.5 10.5a7.5 7.5 0 0013.15 6.15z"/>
            </svg>
          </div>
          <input
            type="text"
            id="mobileSearchInput"
            oninput="handleSearchInput(this.value)"
            placeholder="Search textbooks, course codes, calculators, kits..."
            class="w-full pl-10 pr-9 py-2.5 bg-slate-100 focus:bg-white text-sm text-slate-800 placeholder-slate-400 rounded-xl border border-transparent focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 outline-none transition"
          />
          <button
            id="clearSearchBtnMobile"
            onclick="clearSearch()"
            class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Hero Banner -->
  <section class="bg-gradient-to-br from-[#0B2545] via-[#134074] to-[#0F4C5C] text-white relative overflow-hidden">
    <!-- Subtle Geometric Pattern Overlay -->
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 22px 22px;"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-7 sm:py-10 relative z-10">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-teal-200 text-xs font-semibold mb-3">
            <span>🎓 Independent University, Bangladesh</span>
            <span>•</span>
            <span>Zero Delivery Fees</span>
          </div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight leading-tight">
            Pass Along Books &amp; Lab Gear <span class="text-teal-300">Right on Campus.</span>
          </h1>
          <p class="mt-2.5 text-sm sm:text-base text-slate-200/90 leading-relaxed max-w-xl">
            Buy, sell, or rent semester textbooks, scientific calculators, Arduino kits, and lab coats directly with fellow IUBians at Library Courtyard, Food Court, or Main Gate.
          </p>
        </div>

        <!-- Quick Campus Stats / Meetup Spots -->
        <div class="grid grid-cols-3 gap-2.5 sm:gap-4 shrink-0">
          <div class="bg-white/10 backdrop-blur-xs border border-white/15 rounded-2xl p-3.5 sm:p-4 text-center">
            <div id="statTotalItems" class="text-xl sm:text-2xl font-extrabold text-white">14</div>
            <div class="text-[11px] sm:text-xs text-teal-200 font-medium mt-0.5">Active Listings</div>
          </div>
          <div class="bg-white/10 backdrop-blur-xs border border-white/15 rounded-2xl p-3.5 sm:p-4 text-center">
            <div class="text-xl sm:text-2xl font-extrabold text-emerald-300">৳0</div>
            <div class="text-[11px] sm:text-xs text-teal-200 font-medium mt-0.5">Campus Pickup</div>
          </div>
          <div class="bg-white/10 backdrop-blur-xs border border-white/15 rounded-2xl p-3.5 sm:p-4 text-center">
            <div class="text-xl sm:text-2xl font-extrabold text-amber-300">6 Spots</div>
            <div class="text-[11px] sm:text-xs text-teal-200 font-medium mt-0.5">Safe Meetups</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

    <!-- Category Pills Bar -->
    <div class="flex items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div id="categoryTabs" class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
        <!-- Injected by JS -->
      </div>
    </div>

    <!-- Secondary Filter & Sort Toolbar -->
    <div class="mt-4 bg-white rounded-2xl border border-slate-200/90 p-3.5 sm:p-4 shadow-xs">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        
        <!-- Left Filters: Listing Type & Condition Pills -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-5">
          <!-- Listing Type Segmented Filter -->
          <div class="flex items-center gap-1.5">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-1">Type:</span>
            <div class="inline-flex rounded-xl bg-slate-100 p-1" id="listingTypeFilters">
              <button onclick="setListingTypeFilter('All')" data-type="All" class="type-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition bg-white text-[#0B2545] shadow-xs">All Types</button>
              <button onclick="setListingTypeFilter('Buy')" data-type="Buy" class="type-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900">For Sale</button>
              <button onclick="setListingTypeFilter('Rent')" data-type="Rent" class="type-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900">For Rent</button>
            </div>
          </div>

          <!-- Divider -->
          <div class="hidden sm:block h-6 w-px bg-slate-200"></div>

          <!-- Condition Filter Checkboxes/Pills -->
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider mr-1">Condition:</span>
            <div id="conditionFilters" class="flex flex-wrap items-center gap-1.5">
              <!-- Injected via JS -->
            </div>
          </div>
        </div>

        <!-- Right Controls: Results Count & Sort Dropdown -->
        <div class="flex items-center justify-between sm:justify-end gap-3 pt-2 lg:pt-0 border-t lg:border-t-0 border-slate-100">
          <span id="resultsCountLabel" class="text-xs sm:text-sm font-medium text-slate-500">
            Showing <strong class="text-slate-800">14</strong> items
          </span>

          <div class="flex items-center gap-2">
            <label for="sortSelect" class="text-xs font-semibold text-slate-500 hidden sm:inline">Sort:</label>
            <select
              id="sortSelect"
              onchange="setSortOrder(this.value)"
              class="bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs sm:text-sm font-medium rounded-xl px-3 py-2 outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 cursor-pointer transition"
            >
              <option value="newest">Newest First</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Active Filter Chips Summary (shown when filters are applied) -->
      <div id="activeFilterSummary" class="hidden mt-3 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
        <div id="activeFilterChips" class="flex flex-wrap items-center gap-1.5 text-xs"></div>
        <button onclick="resetAllFilters()" class="text-xs font-semibold text-teal-700 hover:text-teal-800 underline underline-offset-2">
          Clear all filters
        </button>
      </div>
    </div>

    <!-- Product Grid -->
    <div id="productGrid" class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      <!-- Cards injected dynamically by JS -->
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden my-12 bg-white rounded-3xl border border-slate-200/80 p-10 text-center max-w-lg mx-auto shadow-xs">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 flex items-center justify-center text-3xl mb-4">
        🔍
      </div>
      <h3 class="text-lg font-bold text-slate-800">No campus listings matched</h3>
      <p class="mt-1.5 text-sm text-slate-500">
        Try clearing some filters, searching a different course code (like <span class="font-semibold text-slate-700">CSE203</span> or <span class="font-semibold text-slate-700">MAT104</span>), or post a request!
      </p>
      <button
        onclick="resetAllFilters()"
        class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0B2545] hover:bg-[#134074] text-white text-sm font-semibold transition"
      >
        Reset All Filters
      </button>
    </div>

  </main>

  <!-- Campus Footer -->
  <footer class="mt-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div class="flex items-center gap-2">
        <span class="font-bold text-[#0B2545] text-sm">IUB Mart</span>
        <span>•</span>
        <span>Plot 16, Block B, Aftabuddin Ahmed Road, Bashundhara R/A, Dhaka</span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <span>Safe Campus Zones: Main Gate • Library Courtyard • Food Court • Lab Lobby</span>
      </div>
    </div>
  </footer>

  <!-- ===================================================================== -->
  <!-- WISHLIST SLIDE-OVER DRAWER                                            -->
  <!-- ===================================================================== -->
  <div id="wishlistBackdrop" class="fixed inset-0 z-50 hidden">
    <!-- Dimmed overlay -->
    <div onclick="toggleWishlistDrawer(false)" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs transition-opacity"></div>
    
    <!-- Drawer panel -->
    <aside class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl flex flex-col z-10 drawer-enter">
      <!-- Drawer Header -->
      <div class="px-5 py-4 bg-[#0B2545] text-white flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-rose-500/20 border border-rose-400/30 flex items-center justify-center text-rose-400">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-base font-bold leading-tight">Saved Wishlist</h2>
            <p id="drawerCountSubtitle" class="text-xs text-slate-300">0 items saved in browser</p>
          </div>
        </div>
        <button
          onclick="toggleWishlistDrawer(false)"
          class="p-2 rounded-xl text-slate-300 hover:text-white hover:bg-white/10 transition"
          aria-label="Close Wishlist"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Saved Items List -->
      <div id="wishlistItemsContainer" class="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50">
        <!-- Populated dynamically -->
      </div>

      <!-- Drawer Footer with Estimated Cost & Clear -->
      <div id="wishlistFooter" class="p-4 bg-white border-t border-slate-200 space-y-3">
        <div class="flex items-center justify-between text-sm">
          <span class="text-slate-500 font-medium">Estimated Total (Buy + 1st Rent Term):</span>
          <span id="wishlistTotalCost" class="text-lg font-extrabold text-[#0B2545]">৳0</span>
        </div>
        <div class="flex items-center gap-2.5">
          <button
            onclick="clearWishlist()"
            class="w-full py-2.5 px-4 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 font-semibold text-sm transition"
          >
            Clear Wishlist
          </button>
          <button
            onclick="toggleWishlistDrawer(false)"
            class="w-full py-2.5 px-4 rounded-xl bg-[#0B2545] hover:bg-[#134074] text-white font-semibold text-sm transition"
          >
            Continue Browsing
          </button>
        </div>
      </div>
    </aside>
  </div>

  <!-- ===================================================================== -->
  <!-- ITEM DETAILS & CONTACT SELLER MODAL                                   -->
  <!-- ===================================================================== -->
  <div id="detailModalBackdrop" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div onclick="closeDetailModal()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs"></div>
    <div class="min-h-full flex items-center justify-center p-4 relative z-10">
      <div id="detailModalContent" class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl border border-slate-200 overflow-hidden modal-enter">
        <!-- Populated dynamically by JS -->
      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- POST AN ITEM MODAL                                                    -->
  <!-- ===================================================================== -->
  <div id="postModalBackdrop" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div onclick="closePostModal()" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs"></div>
    <div class="min-h-full flex items-center justify-center p-4 relative z-10">
      <div class="bg-white w-full max-w-xl rounded-3xl shadow-2xl border border-slate-200 overflow-hidden modal-enter">
        
        <!-- Modal Header -->
        <div class="px-6 py-4 bg-gradient-to-r from-[#0B2545] to-[#134074] text-white flex items-center justify-between">
          <div>
            <h2 class="text-lg font-bold">Post an Item to IUB Mart</h2>
