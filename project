                  isSaved
                    ? 'bg-rose-50 border-rose-200 text-rose-600'
                    : 'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100'
                }"
              >
                <svg class="w-4 h-4 ${isSaved ? 'fill-rose-500 text-rose-500' : 'text-slate-500'}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                <span>${isSaved ? 'Saved' : 'Save'}</span>
              </button>
            </div>
          </div>

          <!-- Description -->
          <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200/70">
            <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Seller Description</h4>
            <p class="text-sm text-slate-700 leading-relaxed">${escapeHtml(item.description)}</p>
          </div>

          <!-- Seller Profile & Campus Pickup Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Seller Card -->
            <div class="p-3.5 rounded-2xl border border-slate-200 flex items-center gap-3">
              <div class="w-11 h-11 rounded-full bg-gradient-to-br from-[#0B2545] to-teal-600 text-white font-bold text-sm flex items-center justify-center shrink-0">
                ${getInitials(item.seller.name)}
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-1">
                  <span class="text-sm font-bold text-slate-900 truncate">${escapeHtml(item.seller.name)}</span>
                  <span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-full bg-teal-50 text-teal-700 text-[10px] font-bold border border-teal-200">
                    ✓ @iub.edu.bd
                  </span>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">Department of <strong>${escapeHtml(item.seller.dept)}</strong> • ID ${escapeHtml(item.seller.batch)}</p>
              </div>
            </div>

            <!-- Meetup Spot Card -->
            <div class="p-3.5 rounded-2xl border border-teal-200/80 bg-teal-50/40 flex items-center gap-3">
              <div class="w-11 h-11 rounded-xl bg-teal-600 text-white flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <span class="text-[11px] font-bold text-teal-800 uppercase tracking-wider">Preferred Campus Pickup</span>
                <p class="text-sm font-bold text-slate-900">${escapeHtml(item.meetupSpot)}</p>
                <p class="text-[11px] text-slate-500">IUB Bashundhara Campus</p>
              </div>
            </div>
          </div>

          <!-- Interactive Quick-Message / Campus Meetup Request Box -->
          <div class="border-t border-slate-200 pt-4">
            <h4 class="text-xs font-bold text-[#0B2545] uppercase tracking-wider mb-2">
              Send Campus Meetup Request to ${escapeHtml(item.seller.name.split(' ')[0])}
            </h4>

            <!-- Quick Reply Chips -->
            <div class="flex flex-wrap gap-1.5 mb-2.5">
              <button
                type="button"
                onclick="fillQuickMessage('Hi ${escapeHtml(item.seller.name.split(' ')[0])}! Is this still available?')"
                class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium transition"
              >
                "Is this still available?"
              </button>
              <button
                type="button"
                onclick="fillQuickMessage('Can we meet at ${escapeHtml(item.meetupSpot)} between classes today?')"
                class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium transition"
              >
                "Can we meet at ${escapeHtml(item.meetupSpot)}?"
              </button>
              <button
                type="button"
                onclick="fillQuickMessage('Would you accept ৳${Math.max(50, Math.round(item.price * 0.85))} for a quick campus pickup?')"
                class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium transition"
              >
                "Offer ৳${Math.max(50, Math.round(item.price * 0.85))}?"
              </button>
            </div>

            <div class="flex flex-col sm:flex-row gap-2">
              <input
                type="text"
                id="meetupMessageInput"
                value="Hi ${escapeHtml(item.seller.name.split(' ')[0])}! I'm an IUB student interested in this. Can we meet at ${escapeHtml(item.meetupSpot)}?"
                class="flex-1 px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 outline-none"
              />
              <button
                type="button"
                onclick="sendMeetupRequest('${item.id}')"
                class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#0B2545] to-teal-700 hover:from-[#134074] hover:to-teal-600 text-white font-semibold text-sm shadow-sm transition shrink-0 active:scale-95"
              >
                Send Request
              </button>
            </div>

            <!-- Simulated Confirmation Banner -->
            <div id="meetupRequestConfirmation" class="${alreadyRequested ? '' : 'hidden'} mt-3 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs flex items-center gap-2">
              <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span><strong>Meetup Request Sent!</strong> ${escapeHtml(item.seller.name)} (@iub.edu.bd) has been notified to coordinate at <strong>${escapeHtml(item.meetupSpot)}</strong>.</span>
            </div>
          </div>
        </div>
      `;

      document.getElementById('detailModalBackdrop').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeDetailModal() {
      document.getElementById('detailModalBackdrop').classList.add('hidden');
      document.body.style.overflow = '';
    }

    function fillQuickMessage(msg) {
      const input = document.getElementById('meetupMessageInput');
      if (input) {
        input.value = msg;
        input.focus();
      }
    }

    function sendMeetupRequest(itemId) {
      const input = document.getElementById('meetupMessageInput');
      const item = state.listings.find(i => i.id === itemId);
      if (!input || !input.value.trim()) {
        showToast('Please enter a short message for the seller.', 'error');
        return;
      }
      state.requestedItems[itemId] = true;
      const confirmBanner = document.getElementById('meetupRequestConfirmation');
      if (confirmBanner) confirmBanner.classList.remove('hidden');
      showToast(`Campus meetup request sent to ${item.seller.name}!`, 'success');
    }

    // =========================================================================
    // POST NEW ITEM MODAL & FORM SUBMISSION
    // =========================================================================
    function openPostModal() {
      document.getElementById('postModalBackdrop').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closePostModal() {
      document.getElementById('postModalBackdrop').classList.add('hidden');
      document.body.style.overflow = '';
    }

    function toggleRentPeriodField(listingType) {
      const rentWrapper = document.getElementById('rentPeriodWrapper');
      const negoWrapper = document.getElementById('negotiableWrapper');
      if (listingType === 'Rent') {
        rentWrapper.classList.remove('hidden');
        negoWrapper.classList.add('hidden');
      } else {
        rentWrapper.classList.add('hidden');
        negoWrapper.classList.remove('hidden');
      }
    }

    function selectPostEmoji(btn, emoji) {
      document.getElementById('postEmoji').value = emoji;
      document.querySelectorAll('.emoji-btn').forEach(b => {
        b.className = 'emoji-btn w-9 h-9 rounded-xl border border-slate-200 hover:bg-slate-50 text-lg flex items-center justify-center';
      });
      btn.className = 'emoji-btn w-9 h-9 rounded-xl border-2 border-teal-500 bg-teal-50 text-lg flex items-center justify-center';
    }

    function handleCreateListing(event) {
      event.preventDefault();

      const title = document.getElementById('postTitle').value.trim();
      const courseCode = document.getElementById('postCourseCode').value.trim().toUpperCase();
      const category = document.getElementById('postCategory').value;
      const condition = document.getElementById('postCondition').value;
      const listingType = document.getElementById('postListingType').value;
      const price = parseInt(document.getElementById('postPrice').value, 10) || 100;
      const rentPeriod = listingType === 'Rent' ? document.getElementById('postRentPeriod').value : '';
      const negotiable = document.getElementById('postNegotiable').checked;
      const meetupSpot = document.getElementById('postMeetupSpot').value;
      const emoji = document.getElementById('postEmoji').value || '📘';
      const imageUrl = document.getElementById('postImageUrl').value.trim();
      const sellerName = document.getElementById('postSellerName').value.trim();
      const sellerDept = document.getElementById('postSellerDept').value;
      const sellerBatch = document.getElementById('postSellerBatch').value.trim() || '221xxxx';
      const description = document.getElementById('postDescription').value.trim();

      const gradients = [
        'from-teal-50 to-cyan-100',
        'from-blue-50 to-indigo-100',
        'from-emerald-50 to-teal-100',
        'from-amber-50 to-yellow-100'
      ];

      const newListing = {
        id: 'iub-custom-' + Date.now(),
        title,
        courseCode,
        category,
        listingType,
        price,
        rentPeriod,
        negotiable,
        condition,
        meetupSpot,
        emoji,
        imageUrl: imageUrl || '',
        gradient: gradients[Math.floor(Math.random() * gradients.length)],
        seller: {
          name: sellerName,
          dept: sellerDept,
          batch: sellerBatch,
          verified: true
        },
        description,
        createdAt: Date.now()
      };

      // Prepend to state and save to localStorage
      state.listings.unshift(newListing);
      saveCustomListingToStorage(newListing);

      // Reset form & close modal
      document.getElementById('postItemForm').reset();
      toggleRentPeriodField('Buy');
      closePostModal();

      // Re-render marketplace
      renderCategoryTabs();
      renderMarketplace();
      showToast(`"${title}" is now live on IUB Mart!`, 'success');
    }

    // =========================================================================
    // TOAST NOTIFICATIONS & UTILITIES
    // =========================================================================
    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');

      const colors = {
        success: 'bg-[#0B2545] text-white border-teal-500/40',
        info: 'bg-slate-800 text-white border-slate-600',
        error: 'bg-rose-700 text-white border-rose-400'
      };

      const icon = type === 'success' ? '✅' : type === 'error' ? '⚠️' : 'ℹ️';

      toast.className = `pointer-events-auto flex items-center gap-2.5 px-4 py-3 rounded-2xl border shadow-xl text-xs sm:text-sm font-medium transition-all duration-300 translate-y-2 opacity-0 ${colors[type] || colors.info}`;
      toast.innerHTML = `<span>${icon}</span><span class="flex-1">${escapeHtml(message)}</span>`;

      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3200);
    }

    function getInitials(name) {
      return name
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map(n => n[0].toUpperCase())
        .join('');
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Close modals/drawers on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDetailModal();
        closePostModal();
        toggleWishlistDrawer(false);
      }
    });

    // Boot application
    window.addEventListener('DOMContentLoaded', initApp);
  </script>
</body>
</html>
