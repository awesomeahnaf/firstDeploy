      try {
        const savedCustom = JSON.parse(localStorage.getItem(STORAGE_KEYS.CUSTOM_LISTINGS));
        customListings = Array.isArray(savedCustom) ? savedCustom : [];
      } catch (e) {
        customListings = [];
