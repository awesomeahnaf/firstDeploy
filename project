    function handleSearchInput(val) {
      state.searchQuery = val;
      // Sync desktop & mobile search inputs
      const desktopInput = document.getElementById('desktopSearchInput');
      const mobileInput = document.getElementById('mobileSearchInput');
      if (desktopInput && desktopInput.value !== val) desktopInput.value = val;
      if (mobileInput && mobileInput.value !== val) mobileInput.value = val;

      // Toggle clear buttons
      const hasText = val.trim().length > 0;
      document.getElementById('clearSearchBtnDesktop')?.classList.toggle('hidden', !hasText);
      document.getElementById('clearSearchBtnMobile')?.classList.toggle('hidden', !hasText);

      renderMarketplace();
    }

