      let existingCustom = [];
      try {
        existingCustom = JSON.parse(localStorage.getItem(STORAGE_KEYS.CUSTOM_LISTINGS)) || [];
      } catch (e) {
        existingCustom = [];
      }
      existingCustom.unshift(newListing);
      localStorage.setItem(STORAGE_KEYS.CUSTOM_LISTINGS, JSON.stringify(existingCustom));
    }

