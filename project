    function toggleWishlist(event, itemId) {
      if (event) event.stopPropagation();
      const index = state.wishlist.indexOf(itemId);
      const item = state.listings.find(i => i.id === itemId);

      if (index > -1) {
        state.wishlist.splice(index, 1);
        showToast(`Removed "${item ? item.title : 'item'}" from wishlist.`, 'info');
      } else {
        state.wishlist.push(itemId);
        showToast(`Saved "${item ? item.title : 'item'}" to your wishlist!`, 'success');
      }

      saveWishlistToStorage();
      renderMarketplace();
      renderWishlistDrawer();

      // If detail modal is currently open for this item, refresh its heart button
      const openModalBtn = document.getElementById(`modalHeartBtn-${itemId}`);
      if (openModalBtn) {
        openDetailModal(itemId);
      }
    }

