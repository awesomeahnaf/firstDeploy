        const savedWishlist = JSON.parse(localStorage.getItem(STORAGE_KEYS.WISHLIST));
        state.wishlist = Array.isArray(savedWishlist) ? savedWishlist : [];
      } catch (e) {
        state.wishlist = [];
      }

      // Load custom user-posted listings & merge with initial catalog
