          return false;
        }

        // Listing type filter
        if (state.selectedListingType !== 'All' && item.listingType !== state.selectedListingType) {
          return false;
        }

        // Condition filter (if any condition pills are checked)
        if (state.selectedConditions.length > 0 && !state.selectedConditions.includes(item.condition)) {
          return false;
        }

        // Real-time search across title, course code, description, seller, and meetup spot
        if (query) {
          const searchableText = [
            item.title,
            item.courseCode || '',
            item.category,
            item.description,
            item.meetupSpot,
            item.seller.name,
            item.seller.dept
          ].join(' ').toLowerCase();

          if (!searchableText.includes(query)) {
            return false;
          }
        }

        return true;
      });

      // Sorting
      filtered.sort((a, b) => {
        if (state.sortBy === 'price-asc') {
          return a.price - b.price;
        } else if (state.sortBy === 'price-desc') {
          return b.price - a.price;
        } else {
          return b.createdAt - a.createdAt;
        }
      });

      return filtered;
    }

    function setCategoryFilter(categoryId) {
      state.selectedCategory = categoryId;
      renderCategoryTabs();
      renderMarketplace();
    }

    function setListingTypeFilter(type) {
      state.selectedListingType = type;
      document.querySelectorAll('.type-pill').forEach(btn => {
        const isActive = btn.dataset.type === type;
        if (isActive) {
          btn.className = 'type-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition bg-white text-[#0B2545] shadow-xs';
        } else {
          btn.className = 'type-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900';
        }
      });
      renderMarketplace();
    }

    function toggleConditionFilter(condition) {
      const idx = state.selectedConditions.indexOf(condition);
      if (idx > -1) {
        state.selectedConditions.splice(idx, 1);
      } else {
        state.selectedConditions.push(condition);
      }
      renderConditionFilters();
      renderMarketplace();
